    {
      "parameters": {
        "jsCode": "const email = $('검증 결과 확인').item.json.email;\nconst rows = $input.all().map(item => item.json);\n\n// ID는 YYMMDDHHmmss(12자리, KST) 형식 - 별도 날짜 컬럼이 없어 여기서 파싱해 표시용 날짜를 만든다\nfunction idToDate(id) {\n  const s = String(id || '');\n  if (s.length !== 12) return '';\n  const yy = s.slice(0,2), mm = s.slice(2,4), dd = s.slice(4,6), hh = s.slice(6,8), mi = s.slice(8,10);\n  return `20${yy}-${mm}-${dd} ${hh}:${mi}`;\n}\n\nconst 내프로젝트 = rows\n  .filter(r => (r.신청자이메일 || '').trim().toLowerCase() === email.trim().toLowerCase())\n  .sort((a, b) => Number(b.row_number) - Number(a.row_number))\n  .map(r => {\n    const 결제됨 = String(r.결제완료 || '').trim().toUpperCase() === 'TRUE';\n    return {\n      id: r.ID || '',\n      title: r.title || r.Subtopic || '주제 준비 중',\n      status: r.Status || '',\n      form: r.Form || '쇼츠',\n      createdAt: idToDate(r.ID),\n      completedAt: r.CompletedAt || '',\n      errorLog: r.ErrorLog || '',\n      paid: 결제됨,\n      videoUrl: 결제됨 ? (r.video_url || '') : ''\n    };\n  });\n\nreturn [{ json: { found: 내프로젝트.length > 0, projects: 내프로젝트 } }];"
      },
